# ==============================================================================
# Hotel-ECS Gateway Production Environment Configuration Template
# คัดลอกไฟล์นี้เป็น .env แล้วแก้ไขข้อมูลให้ตรงตามสภาพแวดล้อมจริง
# ==============================================================================

# ─── System & Network ─────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=production
BRANCH_ID=branch_01
PUBLIC_URL=https://hotel.nithep.com

# ─── Security & Authentication ────────────────────────────────────────────────
JWT_SECRET=your_super_secret_jwt_key_here
FRONTDESK_PIN=1234
OWNER_PIN=9999

# ─── PBX Hardware Connection (CCH2 Protocol) ─────────────────────────────────
# PBX_MODE: "mock" (จำลอง) | "tcp" (เชื่อมต่อ LAN/IP) | "serial" (RS232)
PBX_MODE=tcp
PBX_HOST=192.168.1.91
PBX_PORT=23
PBX_SERIAL=/dev/ttyUSB0
PBX_BAUD=9600

# ─── Database Configuration ───────────────────────────────────────────────────
# ตำแหน่ง SQLite DB (ถ้าใช้ Docker จะ mount ไปยัง /opt/hotel-ecs/data/)
DATABASE_PATH=/app/backend/hotel.db

# ─── Cloudflare Tunnel Configuration ──────────────────────────────────────────
CLOUDFLARE_TUNNEL_TOKEN=your_secure_cloudflare_tunnel_token_here

# ─── LINE MINI App & LIFF Integration ────────────────────────────────────────
LIFF_APP_URL=https://liff.line.me/your-liff-id

# ─── External Integrations & Notifications ───────────────────────────────────
GOOGLE_CHAT_WEBHOOK_URL=your_google_chat_webhook_url_here
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# ─── AI Model Keys ─────────────────────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here

# ─── SHC API MVP — Policy Layer (Presence / Door / Idle) ──────────────────────
# MQTT broker สำหรับ presence subscriber
# ⚠️ fail-closed: ถ้าว่าง → presence subscriber ไม่เชื่อมต่อ (ห้าม fallback สาธารณะ)
SHC_PRESENCE_MQTT_URL=mqtt://192.168.1.94:1883
# credential แยกเฉพาะ service (1 device/service = 1 credential) — สร้างบน Mosquitto Pi
SHC_PRESENCE_MQTT_USER=shc-presence
SHC_PRESENCE_MQTT_PASS=change_me_on_pi
# dev เท่านั้น: ยอมเชื่อมแบบไม่มี credential (production ต้องเว้นว่าง/false)
SHC_PRESENCE_ALLOW_INSECURE=false
# (legacy) broker รวมของ service อื่น — presence จะใช้ถ้าไม่มี SHC_PRESENCE_MQTT_URL
MQTT_BROKER_URL=
MQTT_USERNAME=
MQTT_PASSWORD=
# topic presence (namespace ใหม่ตาม Mnemo §9.2 ข้อ 1)
SHC_PRESENCE_TOPIC=shc/room/+/presence
SHC_PRESENCE_QOS=1
# idle thresholds (นาที) — ปกติ 20, suite 30
SHC_IDLE_THRESHOLD_MIN_NORMAL=20
SHC_IDLE_THRESHOLD_MIN_SUITE=30
SHC_WARN_LEAD_MIN=1
# ค่า X: door sensor timeout (นาที) — ข้อเสนอ B6 = 10 (ดู rationale ใน shc_policy_config.js)
SHC_DOOR_SENSOR_TIMEOUT_MIN=10
# anti-flap: คำสั่ง relay ห้องเดิมห่างกัน < ค่านี้ (นาที) → deny
SHC_RELAY_MIN_INTERVAL_MIN=2
# sleep guard (ชั่วโมงเต็ม)
SHC_SLEEP_GUARD_START_HOUR=22
SHC_SLEEP_GUARD_END_HOUR=6
# room ที่เป็น suite (comma-separated)
SHC_SUITE_ROOM_IDS=
# ตัวตรวจ idle (วิ) + cron expression
SHC_CHECK_INTERVAL_SEC=60
SHC_CHECKER_CRON=* * * * *
# dry-run: บังคับ ON ตลอด MVP (ห้ามตั้ง false ใน MVP)
SHC_POLICY_DRY_RUN=true
