# ─── HECS Backend Cloud Run (.env) ───────────────────────────────────────────
# คัดลอกไฟล์นี้เป็น .env แล้วแก้ค่าตามสภาพแวดล้อมของคุณ

# Express Server Port (Cloud Run ใช้ 8080 โดยอัตโนมัติ)
PORT=8080

# Branch Identifier (ใช้แยก Topic MQTT ของแต่ละสาขา)
BRANCH_ID=branch-a

# MQTT Broker URL
# Development     : mqtt://broker.hivemq.com:1883  (Public, ไม่ต้อง Auth)
# Local Mosquitto : mqtts://127.0.0.1:8883         (Auth+TLS — ตั้งโดย ops/mosquitto/)
# Production      : mqtts://<cluster>.s1.eu.hivemq.cloud:8883  (HiveMQ Cloud, Auth+TLS)
#                   หรือ  mqtts://<emqx-host>:8883             (EMQX Cloud, Auth+TLS)
MQTT_BROKER=mqtt://broker.hivemq.com:1883
MQTT_USER=
MQTT_PASS=

# TLS: สำหรับ self-signed cert (local Mosquitto) ตั้งเป็น false
# Production (CA จริง) ปล่อยว่างไว้ (default = true เพื่อความปลอดภัย)
MQTT_TLS_REJECT_UNAUTHORIZED=

# LINE Notify Token (สำหรับส่งแจ้งเตือนการเงินเข้า LINE)
LINE_NOTIFY_TOKEN=

# Google API Credentials (Service Account JSON — สำหรับ Calendar/Sheets)
GOOGLE_API_CREDENTIALS=

# ─── Asynchronous State Flow (Session + SSE) ────────────────────────────────
# ระยะเวลาหมดอายุของ session ที่ค้าง PENDING_RELAY (มิลลิวินาที) ก่อนถูกทำเครื่องหมาย TIMEOUT
SESSION_TIMEOUT_MS=30000

# Path ไฟล์ JSON สำหรับ persist สถานะ (ปล่อยว่าง = in-memory เหมาะกับ Cloud Run)
# ใช้สำหรับ Local Dev เท่านั้น เช่น ./state_store.json
STATE_FILE=
