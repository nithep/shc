# ─── LINE LIFF Mini App Environment Template ─────────────────────────────────
# คัดลอกไฟล์นี้เป็น .env แล้วแก้ค่าตามสภาพแวดล้อมของคุณ

# LINE LIFF ID (จาก LINE Developers Console → LIFF)
VITE_LIFF_ID=2010634930-gRJCLqbu

# Cloud Run Backend API Base URL
# - ถ้า LIFF โฮสต์ร่วมกับ API เดียวกัน: ปล่อยว่าง (ใช้ relative path /api)
# - ถ้า Cloud Run แยกโดเมน: ใส่เช่น https://hotel-ecs-backend-xxxx.asia-southeast1.run.app/api
VITE_API_URL=
