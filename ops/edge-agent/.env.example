# ─── HECS Edge Agent Configuration (.env) ─────────────────────────────────────
# คัดลอกไฟล์นี้เป็น .env บน Raspberry Pi Zero 2 W และแก้ไขค่าตามสภาพแวดล้อมจริง
# ⚠️  ห้าม commit ไฟล์ .env เข้า Git Repository เด็ดขาด!

# ─── MQTT Broker Configuration (การเชื่อมต่อ Cloud Backend) ────────────────────
# URL ของ MQTT Broker (ใช้ Public สำหรับ Dev หรือ Private สำหรับ Prod)
MQTT_BROKER_URL=mqtt://broker.hivemq.com:1883

# ชื่อผู้ใช้สำหรับ MQTT (ถ้า Broker ต้องการ Authentication)
MQTT_USERNAME=

# รหัสผ่านสำหรับ MQTT (ถ้า Broker ต้องการ Authentication)
MQTT_PASSWORD=

# ─── Branch Identification (ระบุสาขาของโรงแรม) ─────────────────────────────────
# ต้องตรงกับ BRANCH_ID ที่ตั้งค่าใน Backend Cloud Run
BRANCH_ID=branch-a

# ─── PBX Connection Mode (โหมดการเชื่อมต่อกับตู้สาขา) ──────────────────────────
# ตัวเลือกที่รองรับ:
#   "mock"   = โหมดจำลอง ไม่ต้องต่อฮาร์ดแวร์ (เหมาะสำหรับ Development/Testing)
#   "tcp"    = เชื่อมต่อผ่าน TCP/IP (เหมาะสำหรับ Production หรือ E2E Test กับ Simulator)
#   "serial" = เชื่อมต่อผ่าน Serial Port RS232 (เหมาะสำหรับ Pi ที่ต่อสายตรงเข้าตู้ PBX)
PBX_MODE=tcp

# ─── TCP Mode Configuration (ตั้งค่าเมื่อ PBX_MODE=tcp) ───────────────────────
# IP Address ของตู้ PBX จริง หรือ Python Simulator
# - สำหรับ Digital Twin Simulator: ใช้ 127.0.0.1
# - สำหรับตู้ Phonik PBX จริง: ใช้ IP ในวง LAN เช่น 192.168.1.91
PBX_HOST=192.168.1.91

# พอร์ตการเชื่อมต่อ TCP
# - สำหรับ Digital Twin Simulator: ใช้พอร์ต 2323
# - สำหรับตู้ Phonik PBX จริง (Telnet): ใช้พอร์ต 23
PBX_PORT=23

# ─── Serial Mode Configuration (ตั้งค่าเมื่อ PBX_MODE=serial) ──────────────────
# เส้นทางของ Serial Port บน Linux/Raspberry Pi
# - ส่วนใหญ่จะเป็น /dev/ttyUSB0 (สำหรับ USB-to-Serial Adapter)
# - หรือ /dev/ttyAMA0 (สำหรับ GPIO UART บน Pi)
SERIAL_PATH=/dev/ttyUSB0

# อัตรา baud rate สำหรับการสื่อสารแบบอนุกรม (bps)
# ตู้ Phonik PBX ส่วนใหญ่ใช้ 9600 หรือ 115200
SERIAL_BAUD=9600

# ─── Advanced Settings (ตั้งค่าเพิ่มเติมสำหรับระบบ Self-Healing) ───────────────
# ระยะเวลาระหว่างการส่ง Heartbeat เพื่อตรวจสอบสถานะการเชื่อมต่อ (มิลลิวินาที)
HEARTBEAT_INTERVAL=30000

# จำนวนครั้งที่พยายาม reconnect ก่อนที่จะรอระยะเวลานานขึ้น (Exponential Backoff)
MAX_RECONNECT_ATTEMPTS=5
